<%= form_with(model: report) do |form| %>
  <div>
    <%= form.label :title, style: "display: block" %>
    <%= form.text_field :title, required: true %>
  </div>

  <div>
    <%= form.label :body, style: "display: block" %>
    <%= form.textarea :body, required: true %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
