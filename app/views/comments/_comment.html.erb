<p>
  <strong>
    <% if comment.user %>
      <%= comment.user.name.presence || comment.user.email %>
    <% else %>
      <%= t('views.common.deleted_user') %>
    <% end %>
  </strong>
</p>

<p><%= l comment.created_at, format: :short %></p>

<p><%= comment.body %></p>

<nav class="page-nav">
  <% if comment.user == current_user %>
    <%= link_to t('views.common.edit', name: i18n_pluralize(Comment.model_name.human.downcase)), edit_polymorphic_path([commentable, comment]) %>
    <%= button_to t('views.common.destroy', name: Comment.model_name.human.downcase), [commentable, comment], method: :delete %>
  <% end %>
</nav>
