<div class="show-item">
  <p>
    <strong>
      <%= comment.user ? comment.user.display_name : t('views.common.deleted_user') %>
    </strong>
  </p>

  <p><%= l comment.created_at, format: :short %></p>

  <p><%= comment.body %></p>

  <% if comment.user == current_user %>
    <nav class="page-nav">
      <%= link_to t('views.common.edit', name: i18n_pluralize(Comment.model_name.human.downcase)), [:edit, comment.commentable, comment] %>
      <%= button_to t('views.common.destroy', name: Comment.model_name.human.downcase), [comment.commentable, comment], method: :delete %>
    </nav>
  <% end %>
</div>
